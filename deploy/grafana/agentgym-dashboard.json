{
  "title": "MCP-AgentGym",
  "uid": "agentgym-main",
  "tags": ["agentgym", "agents", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "fault",
        "label": "Fault family",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(agentgym_episodes_total, fault)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "split",
        "label": "Split",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(agentgym_episodes_total, split)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Resolution rate",
      "description": "Share of episodes the executable verifier accepted. This is the headline agent-quality number; everything else on this dashboard explains it.",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.5},
              {"color": "green", "value": 0.8}
            ]
          }
        }
      },
      "targets": [{
        "expr": "sum(rate(agentgym_episodes_total{resolved=\"true\", fault=~\"$fault\", split=~\"$split\"}[$__rate_interval])) / clamp_min(sum(rate(agentgym_episodes_total{fault=~\"$fault\", split=~\"$split\"}[$__rate_interval])), 0.0001)",
        "legendFormat": "resolved"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unsafe actions",
      "description": "Actions taken that the incident's safety policy forbids. Any sustained non-zero value is a release blocker, not a metric to tune.",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "targets": [{
        "expr": "sum(increase(agentgym_unsafe_actions_total{fault=~\"$fault\"}[$__range]))",
        "legendFormat": "unsafe"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Invalid tool-call rate",
      "description": "Calls rejected for an unknown tool name or arguments that failed schema validation. Rises sharply when the tool surface changes under a model that stopped reading the schema.",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.05},
              {"color": "red", "value": 0.15}
            ]
          }
        }
      },
      "targets": [{
        "expr": "sum(rate(agentgym_tool_calls_total{outcome=~\"invalid_args|unknown_tool\"}[$__rate_interval])) / clamp_min(sum(rate(agentgym_tool_calls_total[$__rate_interval])), 0.0001)",
        "legendFormat": "invalid"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Episode p95",
      "description": "Wall time per episode at the 95th percentile.",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(agentgym_episode_seconds_bucket{fault=~\"$fault\"}[$__rate_interval])))",
        "legendFormat": "p95"
      }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Resolution rate by fault family",
      "description": "Which failure modes the agent handles and which it does not. A family flat at zero is usually a capability gap; a family that oscillates is usually a flaky remediation.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [{
        "expr": "sum by (fault) (rate(agentgym_episodes_total{resolved=\"true\", split=~\"$split\"}[$__rate_interval])) / clamp_min(sum by (fault) (rate(agentgym_episodes_total{split=~\"$split\"}[$__rate_interval])), 0.0001)",
        "legendFormat": "{{fault}}"
      }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Mean verified reward by split",
      "description": "Held-out splits diverging from in-distribution is the generalization gap, visible live rather than only at report time.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [{
        "expr": "sum by (fault) (rate(agentgym_episode_reward_sum{fault=~\"$fault\"}[$__rate_interval])) / clamp_min(sum by (fault) (rate(agentgym_episode_reward_count{fault=~\"$fault\"}[$__rate_interval])), 0.0001)",
        "legendFormat": "{{fault}}"
      }]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Tool call outcomes",
      "description": "Stacked by outcome. A growing 'denied' band means the permission policy is doing its job; a growing 'invalid_args' band means the model is guessing at schemas.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 40}
        }
      },
      "targets": [{
        "expr": "sum by (outcome) (rate(agentgym_tool_calls_total[$__rate_interval]))",
        "legendFormat": "{{outcome}}"
      }]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tool latency p95 by tier",
      "description": "Read calls should stay flat; mutating calls include the time the simulated cluster takes to converge, so they are legitimately slower.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(agentgym_tool_latency_seconds_bucket[$__rate_interval])))",
        "legendFormat": "{{tier}}"
      }]
    },
    {
      "id": 30,
      "type": "bargauge",
      "title": "Most-used tools",
      "description": "Which parts of the 36-tool surface the agent actually reaches for. Tools that are never called are either redundant or undiscoverable from their description.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"displayMode": "gradient", "orientation": "horizontal"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [{
        "expr": "topk(15, sum by (tool) (increase(agentgym_tool_calls_total[$__range])))",
        "legendFormat": "{{tool}}"
      }]
    }
  ]
}
