# Copy to env.local.sh (untracked) and edit. Sourced by env.sh before anything else, so
# anything exported here wins over the defaults.
#
# The results in this repository were produced with AGENTGYM_HOME on a shared filesystem
# with room for ~200 GB of model cache, runs and datasets, and AGENTGYM_RUNTIME on
# node-local disk — etcd on NFS is too slow to run episodes at any useful rate.

# export AGENTGYM_HOME=/path/to/large/shared/storage/mcp-agentgym
# export AGENTGYM_RUNTIME="$TMPDIR/$USER/agentgym-runtime"
# export HF_HOME=/path/to/shared/hf_cache
